{
  "http": {
    "routers": {
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-http": {
        "entryPoints": [
          "web"
        ],
        "rule": "Host(`app.example.com`)",
        "service": "noop@internal",
        "middlewares": [
          "nc-https-redirect"
        ]
      },
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-https": {
        "entryPoints": [
          "websecure"
        ],
        "rule": "Host(`app.example.com`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "middlewares": [
          "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-ipallow"
        ],
        "tls": {}
      },
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-probe": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`app.example.com`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "observability": {
          "accessLogs": false
        }
      },
      "nc-gen": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`gen-1.nc.invalid`)",
        "service": "ping@internal",
        "observability": {
          "accessLogs": false
        }
      }
    },
    "services": {
      "nc-11111111-1111-1111-1111-111111111111": {
        "loadBalancer": {
          "passHostHeader": true,
          "servers": [
            {
              "url": "http://nc-app-aaaaaaaa-0:8080"
            }
          ]
        }
      }
    },
    "middlewares": {
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-ipallow": {
        "ipAllowList": {
          "sourceRange": [
            "10.128.0.0/9",
            "10.64.0.0/10",
            "10.32.0.0/11",
            "10.16.0.0/12",
            "10.8.0.0/13",
            "10.4.0.0/14",
            "10.3.0.0/16",
            "10.2.128.0/17",
            "10.2.64.0/18",
            "10.2.32.0/19",
            "10.2.16.0/20",
            "10.2.8.0/21",
            "10.2.4.0/22",
            "10.2.0.0/23",
            "10.2.2.0/24",
            "10.2.3.128/25",
            "10.2.3.64/26",
            "10.2.3.32/27",
            "10.2.3.16/28",
            "10.2.3.8/29",
            "10.2.3.0/30",
            "10.2.3.6/31",
            "10.2.3.5/32",
            "10.0.0.0/16"
          ],
          "ipStrategy": {
            "depth": 1
          },
          "rejectStatusCode": 404
        }
      },
      "nc-https-redirect": {
        "redirectScheme": {
          "scheme": "https",
          "permanent": true
        }
      }
    }
  }
}
