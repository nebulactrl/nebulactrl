{
  "http": {
    "routers": {
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-http": {
        "entryPoints": [
          "web"
        ],
        "rule": "Host(`app.example.com`)",
        "service": "noop@internal",
        "middlewares": [
          "nc-https-redirect"
        ]
      },
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-https": {
        "entryPoints": [
          "websecure"
        ],
        "rule": "Host(`app.example.com`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "middlewares": [
          "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-guard"
        ],
        "tls": {
          "certResolver": "le"
        }
      },
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-probe": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`app.example.com`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "observability": {
          "accessLogs": false
        }
      },
      "nc-11111111-1111-1111-1111-111111111111-dbbbbbbbb-probe": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`t.example.com`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "observability": {
          "accessLogs": false
        }
      },
      "nc-11111111-1111-1111-1111-111111111111-dbbbbbbbb-tunnel": {
        "entryPoints": [
          "tunnel"
        ],
        "rule": "Host(`t.example.com`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "middlewares": [
          "nc-11111111-1111-1111-1111-111111111111-dbbbbbbbb-guard"
        ]
      },
      "nc-11111111-1111-1111-1111-111111111111-http": {
        "entryPoints": [
          "web"
        ],
        "rule": "Host(`extra.example.com`)",
        "service": "noop@internal",
        "middlewares": [
          "nc-https-redirect"
        ]
      },
      "nc-11111111-1111-1111-1111-111111111111-https": {
        "entryPoints": [
          "websecure"
        ],
        "rule": "Host(`extra.example.com`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "middlewares": [
          "nc-11111111-1111-1111-1111-111111111111-guard"
        ],
        "tls": {
          "certResolver": "le"
        }
      },
      "nc-11111111-1111-1111-1111-111111111111-probe": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`extra.example.com`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "observability": {
          "accessLogs": false
        }
      },
      "nc-gen": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`gen-1.nc.invalid`)",
        "service": "ping@internal",
        "observability": {
          "accessLogs": false
        }
      }
    },
    "services": {
      "nc-11111111-1111-1111-1111-111111111111": {
        "loadBalancer": {
          "passHostHeader": true,
          "servers": [
            {
              "url": "http://nc-app-aaaaaaaa-0:8080"
            }
          ]
        }
      }
    },
    "middlewares": {
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-guard": {
