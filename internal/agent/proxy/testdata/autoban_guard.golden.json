        }
      },
      "nc-11111111-1111-1111-1111-111111111111-dbbbbbbbb-guard": {
        "forwardAuth": {
          "address": "http://127.0.0.1:83/v1/check/11111111-1111-1111-1111-111111111111?client=cf"
        }
      },
      "nc-11111111-1111-1111-1111-111111111111-guard": {
        "forwardAuth": {
          "address": "http://127.0.0.1:83/v1/check/11111111-1111-1111-1111-111111111111?client=peer"
        }
      },
      "nc-https-redirect": {
        "redirectScheme": {
          "scheme": "https",
          "permanent": true
        }
