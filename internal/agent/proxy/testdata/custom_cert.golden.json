{
  "http": {
    "routers": {
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-http": {
        "entryPoints": [
          "web"
        ],
        "rule": "Host(`app.example.com`)",
        "service": "noop@internal",
        "middlewares": [
          "nc-https-redirect"
        ]
      },
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-https": {
        "entryPoints": [
          "websecure"
        ],
        "rule": "Host(`app.example.com`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "tls": {}
      },
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-probe": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`app.example.com`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "observability": {
          "accessLogs": false
        }
      },
      "nc-11111111-1111-1111-1111-111111111111-dbbbbbbbb-http": {
        "entryPoints": [
          "web"
        ],
        "rule": "Host(`app.other.org`)",
        "service": "noop@internal",
        "middlewares": [
          "nc-https-redirect"
        ]
      },
      "nc-11111111-1111-1111-1111-111111111111-dbbbbbbbb-https": {
        "entryPoints": [
          "websecure"
        ],
        "rule": "Host(`app.other.org`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "tls": {
          "certResolver": "le"
        }
      },
      "nc-11111111-1111-1111-1111-111111111111-dbbbbbbbb-probe": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`app.other.org`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "observability": {
          "accessLogs": false
        }
      },
      "nc-gen": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`gen-1.nc.invalid`)",
        "service": "ping@internal",
        "observability": {
          "accessLogs": false
        }
      }
    },
    "services": {
      "nc-11111111-1111-1111-1111-111111111111": {
        "loadBalancer": {
          "passHostHeader": true,
          "servers": [
            {
              "url": "http://nc-app-aaaaaaaa-0:8080"
            }
          ]
        }
      }
    },
    "middlewares": {
      "nc-https-redirect": {
        "redirectScheme": {
          "scheme": "https",
          "permanent": true
        }
      }
    }
  },
