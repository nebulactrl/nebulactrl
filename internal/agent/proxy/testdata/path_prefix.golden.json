{
  "http": {
    "routers": {
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-http": {
        "entryPoints": [
          "web"
        ],
        "rule": "Host(`app.example.com`) && PathPrefix(`/api`)",
        "service": "noop@internal",
        "middlewares": [
          "nc-https-redirect"
        ]
      },
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-https": {
        "entryPoints": [
          "websecure"
        ],
        "rule": "Host(`app.example.com`) && PathPrefix(`/api`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "middlewares": [
          "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-strip",
          "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-addprefix"
        ],
        "tls": {
          "certResolver": "le"
        }
      },
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-probe": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`app.example.com`) && PathPrefix(`/api`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "middlewares": [
          "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-strip",
          "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-addprefix"
        ],
        "observability": {
          "accessLogs": false
        }
      },
      "nc-gen": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`gen-1.nc.invalid`)",
        "service": "ping@internal",
        "observability": {
          "accessLogs": false
        }
      }
    },
    "services": {
      "nc-11111111-1111-1111-1111-111111111111": {
        "loadBalancer": {
          "passHostHeader": true,
          "servers": [
            {
              "url": "http://nc-app-aaaaaaaa-0:8080"
            }
          ]
        }
      }
    },
    "middlewares": {
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-addprefix": {
        "addPrefix": {
          "prefix": "/v2"
        }
      },
      "nc-11111111-1111-1111-1111-111111111111-daaaaaaaa-strip": {
        "stripPrefix": {
          "prefixes": [
            "/api"
          ]
        }
      },
      "nc-https-redirect": {
        "redirectScheme": {
          "scheme": "https",
          "permanent": true
        }
      }
    }
  }
}
