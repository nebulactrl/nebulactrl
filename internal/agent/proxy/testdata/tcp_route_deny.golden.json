{
  "http": {
    "routers": {
      "nc-gen": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`gen-1.nc.invalid`)",
        "service": "ping@internal",
        "observability": {
          "accessLogs": false
        }
      }
    },
    "services": {}
  },
  "tcp": {
    "routers": {
      "nc-11111111-1111-1111-1111-111111111111-tcp": {
        "entryPoints": [
          "tcp-5432"
        ],
        "rule": "HostSNI(`*`)",
        "service": "nc-11111111-1111-1111-1111-111111111111-tcp",
        "middlewares": [
          "nc-11111111-1111-1111-1111-111111111111-tcp-allow"
        ]
      }
    },
    "services": {
      "nc-11111111-1111-1111-1111-111111111111-tcp": {
        "loadBalancer": {
          "servers": [
            {
              "address": "nc-pg-aaaaaaaa-0:5432"
            }
          ]
        }
      }
    },
    "middlewares": {
      "nc-11111111-1111-1111-1111-111111111111-tcp-allow": {
        "ipAllowList": {
          "sourceRange": [
            "192.168.128.0/17",
            "192.168.64.0/18",
            "192.168.32.0/19",
            "192.168.16.0/20",
            "192.168.8.0/21",
            "192.168.4.0/23",
            "192.168.6.0/24",
            "192.168.7.128/25",
            "192.168.7.64/26",
            "192.168.7.32/27",
            "192.168.7.16/28",
            "192.168.7.8/29",
            "192.168.7.0/30",
            "192.168.7.4/31",
            "192.168.7.6/32",
            "192.168.2.0/23",
            "192.168.0.0/24"
          ]
        }
      }
    }
  }
}
