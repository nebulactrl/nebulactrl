{
  "http": {
    "routers": {
      "nc-11111111-1111-1111-1111-111111111111-http": {
        "entryPoints": [
          "web"
        ],
        "rule": "Host(`app.example.com`) || Host(`www.example.com`)",
        "service": "noop@internal",
        "middlewares": [
          "nc-https-redirect"
        ]
      },
      "nc-11111111-1111-1111-1111-111111111111-https": {
        "entryPoints": [
          "websecure"
        ],
        "rule": "Host(`app.example.com`) || Host(`www.example.com`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "middlewares": [
          "nc-errors"
        ],
        "tls": {
          "certResolver": "le"
        }
      },
      "nc-11111111-1111-1111-1111-111111111111-probe": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`app.example.com`) || Host(`www.example.com`)",
        "service": "nc-11111111-1111-1111-1111-111111111111",
        "observability": {
          "accessLogs": false
        }
      },
      "nc-22222222-2222-2222-2222-222222222222-daaaaaaaa-http": {
        "entryPoints": [
          "web"
        ],
        "rule": "Host(`api.example.com`)",
        "service": "noop@internal",
        "middlewares": [
          "nc-https-redirect"
        ]
      },
      "nc-22222222-2222-2222-2222-222222222222-daaaaaaaa-https": {
        "entryPoints": [
          "websecure"
        ],
        "rule": "Host(`api.example.com`)",
        "service": "nc-22222222-2222-2222-2222-222222222222",
        "middlewares": [
          "nc-errors",
          "nc-22222222-2222-2222-2222-222222222222-daaaaaaaa-compress"
        ],
        "tls": {
          "certResolver": "le"
        }
      },
      "nc-22222222-2222-2222-2222-222222222222-daaaaaaaa-probe": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`api.example.com`)",
        "service": "nc-22222222-2222-2222-2222-222222222222",
        "observability": {
          "accessLogs": false
        }
      },
      "nc-gen": {
        "entryPoints": [
          "probe"
        ],
        "rule": "Host(`gen-1.nc.invalid`)",
        "service": "ping@internal",
        "observability": {
          "accessLogs": false
        }
      },
      "nc-pages-notfound-http": {
        "entryPoints": [
          "web"
        ],
        "rule": "PathPrefix(`/`)",
        "service": "nc-pages",
        "middlewares": [
          "nc-pages-notfound"
        ],
        "priority": 1
      },
      "nc-pages-notfound-https": {
        "entryPoints": [
          "websecure"
        ],
        "rule": "PathPrefix(`/`)",
        "service": "nc-pages",
        "middlewares": [
          "nc-pages-notfound"
        ],
        "tls": {},
        "priority": 1
      }
    },
    "services": {
      "nc-11111111-1111-1111-1111-111111111111": {
        "loadBalancer": {
          "passHostHeader": true,
          "servers": [
            {
              "url": "http://nc-app-aaaaaaaa-0:8080"
            }
          ]
        }
      },
      "nc-22222222-2222-2222-2222-222222222222": {
        "loadBalancer": {
          "passHostHeader": true,
          "servers": [
            {
              "url": "http://nc-app-aaaaaaaa-0:8080"
            }
          ]
        }
      },
      "nc-pages": {
        "loadBalancer": {
          "passHostHeader": true,
          "servers": [
            {
              "url": "http://nebulactrl-pages:8080"
            }
          ]
        }
      }
    },
    "middlewares": {
      "nc-22222222-2222-2222-2222-222222222222-daaaaaaaa-compress": {
        "compress": {
          "encodings": [
            "zstd",
            "br",
            "gzip"
          ],
          "excludedContentTypes": [
            "text/event-stream"
          ]
        }
      },
      "nc-errors": {
        "errors": {
          "status": [
            "502-504"
          ],
          "service": "nc-pages",
          "query": "/err/{status}"
        }
      },
      "nc-https-redirect": {
        "redirectScheme": {
          "scheme": "https",
          "permanent": true
        }
      },
      "nc-pages-notfound": {
        "replacePath": {
          "path": "/err/404"
        }
      }
    }
  }
}
