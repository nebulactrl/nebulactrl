// NebulaCtrl mesh rules. Add the tagOwners entry once, and keep the acls
// below in sync when NebulaCtrl shows new rules. Default is deny: nothing
// else is opened.
{
  "tagOwners": {"tag:nebula-mesh": ["autogroup:admin"]},
  "acls": [
    // service link l1
    {"action":"accept","src":["100.64.0.10"],"dst":["100.64.0.2:8080"]}
  ]
}
