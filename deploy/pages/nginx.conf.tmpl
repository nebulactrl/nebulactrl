# Generated by the NebulaCtrl agent. Do not edit: the container is recreated when it changes.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 512;
}

http {
    types { text/html html; }
    default_type text/html;
    charset utf-8;
    server_tokens off;
    access_log off;
    sendfile on;
    client_body_temp_path /tmp/nginx-body;
    proxy_temp_path /tmp/nginx-proxy;
    fastcgi_temp_path /tmp/nginx-fastcgi;
    uwsgi_temp_path /tmp/nginx-uwsgi;
    scgi_temp_path /tmp/nginx-scgi;

    server {
        listen {{.Port}} default_server;
        server_name _;
        root {{.Root}};

        error_page 404 /p/404.html;
        error_page 502 /p/502.html;
        error_page 503 /p/503.html;
        error_page 504 /p/504.html;

        # Readiness of the container itself (the agent's exec check).
        location = /healthz { access_log off; add_header Cache-Control "no-store" always; return 200 "ok\n"; }

        # Entry points. Traefik's errors middleware asks for /err/<status>; the
        # catch-all router asks for /err/404. The status code is the response's.
        location = /err/404 { return 404; }
        location = /err/502 { return 502; }
        location = /err/503 { return 503; }
        location = /err/504 { return 504; }

        # Rendered pages: internal only, served with the status of the error.
        location = /p/404.html { internal; {{.Headers}} }
        location = /p/502.html { internal; {{.Headers}} add_header Retry-After "30" always; }
        location = /p/503.html { internal; {{.Headers}} add_header Retry-After "30" always; }
        location = /p/504.html { internal; {{.Headers}} add_header Retry-After "30" always; }
{{range .Services}}
        # maintenance: service {{.ID}}
        location = /m/{{.ID}} { error_page 503 /p/m-{{.ID}}.html; return 503; }
        location = /p/m-{{.ID}}.html { internal; {{$.Headers}} add_header Retry-After "{{.RetryAfter}}" always; }
{{end}}
        location / { return 404; }
    }
}
