<!doctype html>
<html lang="en" data-kind="{{.Kind}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<meta name="color-scheme" content="dark">
<title>{{.Title}}</title>
<style>{{.Style}}</style>
</head>
<body{{if .Preview}} data-preview{{end}}>
<canvas data-ascii-canvas aria-hidden="true" role="presentation"></canvas>
<div class="veil" aria-hidden="true"></div>
<main>
<div class="mark" data-ascii-quiet aria-hidden="true"><svg viewBox="0 0 26 26" fill="none"><defs><linearGradient id="g" x1="3" y1="23" x2="23" y2="3" gradientUnits="userSpaceOnUse"><stop stop-color="#9a6bff"/><stop offset=".55" stop-color="#6d6bff"/><stop offset="1" stop-color="#4fa8ff"/></linearGradient></defs><circle cx="13" cy="13" r="7" fill="url(#g)"/><ellipse cx="13" cy="13" rx="12" ry="3.6" transform="rotate(-24 13 13)" stroke="url(#g)" stroke-width="1.4"/></svg></div>
<section class="card" data-ascii-card data-tone="{{.Tone}}">
<p class="kicker"><span class="lamp" aria-hidden="true"></span>{{.Kicker}}</p>
<h1>{{.Title}}</h1>
<p class="msg">{{.Message}}</p>
{{- if .ETA}}
<p class="eta">Expected back around <time datetime="{{.ETAISO}}">{{.ETAText}}</time></p>
{{- end}}
<p class="host"{{if not .Host}} hidden{{end}}><code id="host">{{.Host}}</code></p>
</section>
</main>
<script>{{.Script}}</script>
<script>{{.Engine}}</script>
</body>
</html>
