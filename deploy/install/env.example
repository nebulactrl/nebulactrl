# For a by-hand install: copy to /opt/nebulactrl/.env (mode 0600) next to
# docker-compose.yml. The installer generates this file itself; every secret
# below must be generated once and never shared.

NEBULACTRL_IMAGE=nebulactrl:local
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32   -- BACK THIS UP apart from the database backups.
NEBULACTRL_SECRET_KEY=
# The URL users and agents use (https:// in production).
NEBULACTRL_PUBLIC_URL=https://nebula.example.com
NEBULACTRL_BIND=127.0.0.1
NEBULACTRL_PORT=8080

# Installer features; leave empty to switch each off. Exception: an empty NEBULACTRL_SETUP_TOKEN makes the server generate a one-time token at start and log it ("first-run setup") while no user exists.
NEBULACTRL_SETUP_TOKEN=
NEBULACTRL_DASHBOARD_UPSTREAM=
# Where the host's proxy sends published status-page hostnames (the status listener, :8081 in the container; never published on the host).
NEBULACTRL_STATUS_UPSTREAM=
NEBULACTRL_LOCAL_ENROLL_TOKEN=
NEBULACTRL_LOCAL_SERVER_NAME=
NEBULACTRL_LOCAL_SERVER_IP=
NEBULACTRL_ACME_EMAIL=
# Dashboard access (needs a domain): comma-separated CIDRs, a DNS-01 provider (cloudflare) and its API token.
NEBULACTRL_DASHBOARD_ALLOW_CIDRS=
NEBULACTRL_DASHBOARD_DNS_RESOLVER=
NEBULACTRL_DASHBOARD_DNS_TOKEN=

NEBULACTRL_BACKUP_HOST_DIR=/var/backups/nebulactrl
# Leave unset: the instance admin switches MCP in Settings. true or false here decides and locks that switch.
NEBULACTRL_MCP_ENABLED=
NEBULACTRL_LOG_LEVEL=info

# Optional. The control plane reads https://nebulactrl.com/releases/latest.json once a day and shows a notice when a newer release exists.
# NEBULACTRL_UPDATE_CHECK=false turns the check (and the notice) off; NEBULACTRL_UPDATE_FEED_URL reads a mirror instead.
# NEBULACTRL_UPDATE_CHECK=true
# NEBULACTRL_UPDATE_FEED_URL=

# Optional. Git servers you host on a private network (comma separated host names, IPs or CIDRs, e.g. git.corp.example,10.0.0.0/24).
# The control plane refuses private, loopback and link-local addresses for git remotes and git providers otherwise.
# NEBULACTRL_GIT_ALLOW_PRIVATE=

# Postgres tuning (defaults suit 1 GB RAM).
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=512MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_MAX_CONNECTIONS=100
PG_RANDOM_PAGE_COST=1.1
