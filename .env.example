# NebulaCtrl development configuration. Copy to .env (`make setup` does this and
# generates a secret key for you). .env is git-ignored. Contains no real secrets.

# --- Control plane (cmd/server) ---------------------------------------------

# Postgres connection string. Matches deploy/dev/docker-compose.yml (`make dev-deps`).
# Host port for the dev Postgres container (change if 5432 is taken; update the URLs below too).
NEBULACTRL_DEV_PG_PORT=5432
NEBULACTRL_DATABASE_URL=postgres://nebulactrl:nebulactrl@localhost:5432/nebulactrl?sslmode=disable

# REQUIRED. Base64 of exactly 32 random bytes. Encrypts every sealed value:
# variables, git tokens, registry and integration credentials, SSH keys, TOTP
# seeds (AES-256-GCM). Generate with `make keygen`
# (= `go run ./cmd/server keygen`) or `openssl rand -base64 32`.
# Never lose it or replace it: rotate with `nebulactrl-server rekey` (see
# docs/security/secrets-at-rest.md): put the new key here, the old one in
# NEBULACTRL_SECRET_KEY_PREVIOUS, restart, run rekey, then remove the old one.
# Back it up with the database in any real deployment. Never commit the real value.
# NEBULACTRL_SECRET_KEY_FILE=/path/to/key can be used instead (not together).
NEBULACTRL_SECRET_KEY=
# NEBULACTRL_SECRET_KEY_PREVIOUS=

# Address the HTTP server binds to.
NEBULACTRL_LISTEN=:8080
# Address of the public status-page listener (serves published status pages by Host, nothing
# else; default :8081). Change it when the port is taken; never expose it to the internet directly.
# NEBULACTRL_STATUS_LISTEN=:8081
# Dev-only overrides when default ports are taken on your workstation:
# NEBULACTRL_DEV_CP_PORT must match NEBULACTRL_LISTEN (agent1 dials it);
# NEBULACTRL_API_URL points the Vite proxy at the control plane.
# NEBULACTRL_DEV_CP_PORT=8080
# NEBULACTRL_API_URL=http://127.0.0.1:8080
# NEBULACTRL_DEV_AGENT1_HTTP_PORT=8880
# NEBULACTRL_DEV_AGENT1_HTTPS_PORT=8443

# Externally visible base URL of the control plane. Used for the agent install
# command and to decide whether the session cookie is Secure (https only).
NEBULACTRL_PUBLIC_URL=http://localhost:8080

# The optional MCP endpoint at /mcp (bearer API token only) is off by default.
# Leave unset: the instance admin switches it in Admin -> MCP. true or false decides and locks that switch.
# NEBULACTRL_MCP_ENABLED=

# debug | info | warn | error. Logs are JSON on stdout.
NEBULACTRL_LOG_LEVEL=debug

# The check for a newer release: the control plane reads this feed once a day and shows a
# notice in the sidebar and Admin -> Updates. false never contacts it. To try the notice
# on a dev stack, serve a JSON file ({"version":"9.9.9","publishedAt":"2026-01-01T00:00:00Z",
# "notesUrl":"https://example.test/r","notes":"## Notes"}) and point the feed at it over https
# (a plain http feed is refused: the update it announces runs as root); a dev
# build ("dev") never shows an update, so run the server with -ldflags "-X main.version=0.1.0".
# NEBULACTRL_UPDATE_CHECK=true
# NEBULACTRL_UPDATE_FEED_URL=https://localhost:9099/releases/latest.json

# Directory holding agent binaries served at /agent/v1/download/{amd64|arm64}.
# `make build-agents` fills ./bin/agents.
NEBULACTRL_AGENT_BINARIES_DIR=./bin/agents

# Directory holding the CLI builds served at /download/cli/{os}/{arch} (plus SHA256SUMS,
# installed by /cli.sh): <os>-<arch>/nebulactrl[.exe]. Unset in development: those routes
# answer 404 with a message. The image sets it to /usr/share/nebulactrl/cli.
# NEBULACTRL_CLI_BINARIES_DIR=

# Root of "directory on the control-plane host" destinations of the control-plane
# backup (Admin -> Control-plane backup). Empty disables that option; use an S3-compatible
# bucket instead. The backup itself needs pg_dump (PostgreSQL client tools) on PATH.
# NEBULACTRL_BACKUP_DIR=./bin/backups
# Largest dump file a managed database can be restored from (bytes, default 5 GiB).
# NEBULACTRL_MAX_DUMP_UPLOAD_BYTES=5368709120

# Advanced timers (Go durations, docs/operations/configuration.md). Leave unset: the
# defaults are the production behavior; the integration tests set short values.
# How long a cross-server link grant whose variable reference is gone stays (default 10m).
# NEBULACTRL_MESH_LINK_GRACE=10m
# How long a database replica may stop streaming before it is "broken" (default 2m, keep > 30s).
# NEBULACTRL_REPLICA_BROKEN_AFTER=2m
# How often agents probe services for uptime (default 30s; the control plane derives its "unknown after
# 3 intervals + 30s" rule from it; the agent reads the same variable, test and diagnostic knob).
# NEBULACTRL_UPTIME_INTERVAL=30s

# --- Tests -------------------------------------------------------------------

# Database used by DB-backed tests. `make test-smoke` / `make test-full` create it inside the
# dev Postgres. Never point this at a database you care about.
NEBULACTRL_TEST_DATABASE_URL=postgres://nebulactrl:nebulactrl@localhost:5432/nebulactrl_test?sslmode=disable

# Set to 1 (with the `multi` compose profile up) to run the multi-server test.
NEBULACTRL_TEST_MULTI=0

# Enrollment token of the agent1 dev stack, used by the Playwright smoke test
# (`make e2e`). Create a token in the UI (Servers -> Add server) or via the API.
E2E_ENROLL_TOKEN=

# --- Dev agents (deploy/dev/docker-compose.yml) -------------------------------
# Enrollment tokens are single-use and are NOT read from this file. Pass them on
# the command line:
#   make dev-agent TOKEN=nct_enroll_...
#   NEBULACTRL_ENROLL_TOKEN_2=nct_enroll_... docker compose -f deploy/dev/docker-compose.yml --profile multi up --build
# Once an agent has enrolled, its identity lives in the agent1-state / agent2-state
# volume and no token is needed on later starts.
